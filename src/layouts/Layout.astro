---
import "../styles/global.css";
import CrtOverlay from "../components/CrtOverlay.astro";
import IconSprite from "../components/IconSprite.astro";
import { DEFAULT_LOCALE, LOCALES, dict, localeHome, toLocale } from "../i18n";

interface Props {
	title?: string;
	description?: string;
}

const locale = toLocale(Astro.currentLocale);
const t = dict(locale);

const { title = t.meta.title, description = t.meta.description } = Astro.props;
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#161317" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content={locale} />
		<title>{title}</title>

		{
			LOCALES.map((l) => (
				<link rel="alternate" hreflang={l} href={localeHome(l)} />
			))
		}
		<link rel="alternate" hreflang="x-default" href={localeHome(DEFAULT_LOCALE)} />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body class="pb-8">
		<a
			href="#sobre"
			class="sr-only font-mono text-xs focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-60 focus:bg-panel focus:px-3 focus:py-2 focus:text-amber"
			>{t.nav.skipToContent}</a
		>
		<IconSprite />
		<CrtOverlay />
		<slot />
	</body>
</html>
