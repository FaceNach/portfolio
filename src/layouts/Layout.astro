---
import "../styles/global.css";
import { Font } from "astro:assets";
import CrtOverlay from "../components/CrtOverlay.astro";
import IconSprite from "../components/IconSprite.astro";
import { SECTION } from "../data/sections";
import { DEFAULT_LOCALE, LOCALES, dict, localeHome, toLocale } from "../i18n";

interface Props {
	title?: string;
	description?: string;
}

const locale = toLocale(Astro.currentLocale);
const t = dict(locale);

const { title = t.meta.title, description = t.meta.description } = Astro.props;

const abs = (path: string) => new URL(path, Astro.site).href;
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#161317" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content={locale} />
		<title>{title}</title>

		{
			LOCALES.map((l) => (
				<link rel="alternate" hreflang={l} href={abs(localeHome(l))} />
			))
		}
		<link
			rel="alternate"
			hreflang="x-default"
			href={abs(localeHome(DEFAULT_LOCALE))}
		/>
		<link rel="canonical" href={abs(Astro.url.pathname)} />

		<Font
			cssVariable="--font-ibm-plex-mono"
			preload={[
				{ weight: 400, subset: "latin" },
				{ weight: 600, subset: "latin" },
			]}
		/>
		<Font
			cssVariable="--font-ibm-plex-sans"
			preload={[{ weight: 400, subset: "latin" }]}
		/>
	</head>
	<body class="pb-8">
		<a
			href={`#${SECTION.about}`}
			class="sr-only font-mono text-xs focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-60 focus:bg-panel focus:px-3 focus:py-2 focus:text-amber"
			>{t.nav.skipToContent}</a
		>
		<IconSprite />
		<CrtOverlay />
		<slot />
	</body>
</html>
