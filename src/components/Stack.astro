---
import TechMarquee from "./TechMarquee.astro";
import { SECTION } from "../data/sections";
import { dict } from "../i18n";

const t = dict(Astro.currentLocale);
---

<section
	id={SECTION.stack}
	class="scroll-mt-14 border-t border-amber/15 bg-panel px-5 py-14 sm:px-8 md:px-14 md:py-20"
>
	<div class="mx-auto max-w-[72rem]">
		<p class="font-mono text-xs tracking-[0.14em] text-amber">
			{t.stack.label}
		</p>
		<h2
			class="mt-3 font-mono text-2xl font-medium tracking-[-0.02em] text-bone sm:text-3xl"
		>
			{t.stack.heading}
		</h2>
		<div class="mt-8">
			<TechMarquee />
		</div>

		<dl class="mt-8 border-t border-amber/15">
			{
				t.stack.groups.map((group) => (
					<div class="grid gap-2 border-b border-amber/15 py-5 sm:grid-cols-[14ch_minmax(0,1fr)] sm:gap-6">
						<dt class="font-mono text-xs text-faint sm:pt-1">{group.name}</dt>
						<dd class="flex flex-wrap gap-x-6 gap-y-2">
							{group.items.map((item) => (
								<span class="font-mono text-sm text-amber sm:text-base">
									{item}
								</span>
							))}
						</dd>
					</div>
				))
			}
		</dl>

		<div class="mt-8">
			<TechMarquee reverse />
		</div>
	</div>
</section>
