---
import { iconsFor } from "../data/tech";
import t from "../i18n/dataEs";

interface Props {
	reverse?: boolean;
}

const { reverse = false } = Astro.props;

const items = iconsFor(t.stack.groups.flatMap((group) => group.items));

const track = [...items, ...items];
---

<div
	class="relative overflow-hidden border-y border-amber/15 py-4 [mask-image:linear-gradient(to_right,transparent,black_6%,black_94%,transparent)]"
	aria-hidden="true"
>
	<div
		class:list={[
			"flex w-max animate-marquee items-center hover:[animation-play-state:paused]",
			reverse && "[animation-direction:reverse]",
		]}
	>
		{
			track.map((item) => (
				<div class="flex shrink-0 items-center gap-2.5 pr-10">
					<svg viewBox="0 0 24 24" class="size-[18px] shrink-0 fill-amber/70">
						<path d={item.icon.path} />
					</svg>
					<span class="font-mono text-xs whitespace-nowrap text-muted">
						{item.name}
					</span>
				</div>
			))
		}
	</div>
</div>
