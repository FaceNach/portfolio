---
import Icon from "./Icon.astro";
import { iconsFor } from "../data/tech";
import { iconId } from "../data/icons";
import { dict } from "../i18n";

const t = dict(Astro.currentLocale);

interface Props {
	reverse?: boolean;
}

const { reverse = false } = Astro.props;

const items = iconsFor(t.stack.groups.flatMap((group) => group.items));

const track = [...items, ...items];
---

<div
	class="relative overflow-hidden border-y border-amber/25 py-4 [mask-image:linear-gradient(to_right,transparent,black_6%,black_94%,transparent)]"
	aria-hidden="true"
>
	<div
		class:list={[
			"flex w-max animate-marquee items-center hover:[animation-play-state:paused]",
			reverse && "[animation-direction:reverse]",
		]}
	>
		{
			track.map((item) => (
				<div class="flex shrink-0 items-center gap-2.5 pr-10">
					<Icon
						id={iconId(item.name)}
						class="size-[18px] shrink-0 fill-amber/70"
					/>
					<span class="font-mono text-xs whitespace-nowrap text-muted">
						{item.name}
					</span>
				</div>
			))
		}
	</div>
</div>
