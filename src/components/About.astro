---
import { about } from "../data/portfolio";
---

<section
	id="about"
	class="scroll-mt-[65px] border-t border-faint/20 px-6 py-[88px] md:px-12 md:py-[140px]"
>
	<div
		class="mx-auto grid max-w-[1100px] items-start gap-10 md:grid-cols-[280px_1fr] md:gap-16"
	>
		<h3
			class="font-display text-[40px] leading-[1.04] font-bold italic md:text-[56px]"
		>
			<span class="text-gold">Sobre</span><br />
			<span class="text-muted">mí</span>
		</h3>
		<div class="space-y-[18px]">
			{
				about.map((paragraph) => (
					<p class="text-base leading-[1.8] text-muted">{paragraph}</p>
				))
			}
		</div>
	</div>
</section>
