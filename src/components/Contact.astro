---
import { profile } from "../data/portfolio";

const year = new Date().getFullYear();
---

<section
	id="contacto"
	class="scroll-mt-[65px] border-t border-faint/20 bg-ink-alt px-6 pt-[88px] pb-[72px] md:px-12 md:pt-[140px] md:pb-[100px]"
>
	<div class="mx-auto max-w-[760px] text-center">
		<h3 class="mb-5 font-display text-[38px] font-semibold text-bone">
			Hablemos
		</h3>
		<p class="mb-10 text-base leading-[1.7] text-muted">
			¿Tenés un proyecto en mente o una oportunidad? Escribime, siempre estoy
			abierto a nuevas conversaciones.
		</p>

		<a
			href={`mailto:${profile.email}`}
			class="mb-12 inline-block rounded-lg bg-gold px-9 py-4 font-display text-base font-semibold text-ink no-underline transition-colors hover:bg-gold-light"
		>
			{profile.email}
		</a>

		<div class="flex justify-center gap-5">
			<a
				href={profile.github}
				aria-label="GitHub"
				class="flex size-12 items-center justify-center rounded-full border border-faint text-muted transition-colors hover:border-gold hover:text-gold"
			>
				<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"
					><path
						d="M12 .5C5.73.5.5 5.73.5 12c0 5.09 3.29 9.4 7.86 10.93.57.1.79-.25.79-.55 0-.27-.01-1.16-.02-2.11-3.2.7-3.88-1.36-3.88-1.36-.52-1.33-1.28-1.69-1.28-1.69-1.04-.72.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.56-.29-5.25-1.28-5.25-5.7 0-1.26.45-2.28 1.18-3.09-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.05 11.05 0 0 1 5.79 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.24 2.76.12 3.05.74.81 1.18 1.83 1.18 3.09 0 4.43-2.7 5.4-5.27 5.69.41.36.78 1.08.78 2.17 0 1.57-.01 2.83-.01 3.22 0 .3.21.66.8.55A11.5 11.5 0 0 0 23.5 12C23.5 5.73 18.27.5 12 .5Z"
					></path></svg
				>
			</a>
			<a
				href={profile.linkedin}
				aria-label="LinkedIn"
				class="flex size-12 items-center justify-center rounded-full border border-faint text-muted transition-colors hover:border-gold hover:text-gold"
			>
				<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"
					><path
						d="M4.98 3.5C4.98 4.88 3.87 6 2.5 6S.02 4.88.02 3.5C.02 2.12 1.13 1 2.5 1s2.48 1.12 2.48 2.5ZM.5 8.24h4V23h-4V8.24Zm7.5 0h3.83v2.02h.05c.53-1 1.84-2.05 3.79-2.05 4.06 0 4.81 2.67 4.81 6.14V23h-4v-7.14c0-1.7-.03-3.9-2.38-3.9-2.38 0-2.75 1.86-2.75 3.78V23h-4V8.24Z"
					></path></svg
				>
			</a>
		</div>

		<p class="mt-16 font-mono text-xs text-faint">
			© {year} {profile.name} — hecho con Astro
		</p>
	</div>
</section>
