---
import t from "../i18n/dataEs";

const year = new Date().getFullYear();
---

<section
	id="contacto"
	class="scroll-mt-14 border-t border-amber/15 bg-panel px-5 py-14 sm:px-8 md:px-14 md:py-20"
>
	<div class="mx-auto max-w-[72rem]">
		<p class="font-mono text-xs tracking-[0.14em] text-amber">
			{t.contact.label}
		</p>
		<h2
			class="mt-3 font-mono text-2xl font-medium tracking-[-0.02em] text-bone sm:text-3xl"
		>
			{t.contact.heading}
		</h2>
		<p class="mt-4 max-w-[52ch] text-[15px] leading-[1.75] text-bone">
			{t.contact.body}
		</p>

		<a
			href={`mailto:${t.contact.email}`}
			class="mt-8 inline-block font-mono text-[clamp(1.25rem,4.5vw,2.25rem)] text-amber underline-offset-[6px] transition-colors hover:text-amber-hi hover:underline phosphor"
		>
			{t.contact.email}
		</a>

		<div class="mt-10 flex flex-wrap gap-x-8 gap-y-3 font-mono text-sm">
			<a
				href={t.contact.github}
				class="text-muted underline-offset-4 transition-colors hover:text-amber hover:underline"
				>{t.contact.githubLabel} →</a
			>
			<a
				href={t.contact.linkedin}
				class="text-muted underline-offset-4 transition-colors hover:text-amber hover:underline"
				>{t.contact.linkedinLabel} →</a
			>
		</div>

		<div
			class="mt-12 flex flex-wrap items-center justify-between gap-2 border-t border-amber/15 pt-5 font-mono text-[11px] text-faint"
		>
			<span>© {year} Ignacio Gunst</span>
			<span>{t.contact.footer}</span>
		</div>
	</div>
</section>
