---
import Icon from "./Icon.astro";
import { dict } from "../i18n";

const t = dict(Astro.currentLocale);

const year = new Date().getFullYear();

const social = [
	{ href: t.contact.github, label: t.contact.githubLabel, icon: "icon-github" },
	{
		href: t.contact.linkedin,
		label: t.contact.linkedinLabel,
		icon: "icon-linkedin",
	},
];

const emailEncoded = btoa(t.contact.email);

const itemClass =
	"group flex cursor-pointer items-center gap-2.5 text-amber transition-colors hover:text-amber-hi";
const iconClass = "size-4 shrink-0 fill-current";
const labelClass = "underline-offset-4 group-hover:underline";
---

<section
	id="contacto"
	class="scroll-mt-14 border-t border-amber/15 bg-panel px-5 py-14 sm:px-8 md:px-14 md:py-20"
>
	<div class="mx-auto max-w-[72rem]">
		<p class="font-mono text-xs tracking-[0.14em] text-amber">
			{t.contact.label}
		</p>
		<h2
			class="mt-3 font-mono text-2xl font-medium tracking-[-0.02em] text-bone sm:text-3xl"
		>
			{t.contact.heading}
		</h2>
		<p class="mt-4 max-w-[52ch] text-[15px] leading-[1.75] text-bone">
			{t.contact.body}
		</p>

		<div
			class="relative mt-8 flex flex-wrap items-center gap-x-8 gap-y-3 font-mono text-base"
		>
			<button
				type="button"
				id="copy-mail"
				data-email={emailEncoded}
				data-copied={t.contact.emailCopied}
				data-failed={t.contact.emailFailed}
				aria-label={t.contact.emailAction}
				class={itemClass}
			>
				<Icon id="icon-mail" class={iconClass} />
				<span class={labelClass}>{t.contact.emailLabel}</span>
			</button>

			{
				social.map((item) => (
					<a
						href={item.href}
						target="_blank"
						rel="noopener noreferrer"
						class={itemClass}
					>
						<Icon id={item.icon} class={iconClass} />
						<span class={labelClass}>{item.label} →</span>
					</a>
				))
			}

			<span
				id="copy-toast"
				role="status"
				aria-live="polite"
				class="pointer-events-none absolute -top-9 left-0 border border-amber/40 bg-cell px-2.5 py-1 text-[11px] text-amber-hi opacity-0 transition-opacity duration-200"
			></span>
		</div>

		<div
			class="mt-12 flex flex-wrap items-center justify-between gap-2 border-t border-amber/15 pt-5 font-mono text-[11px] text-faint"
		>
			<span>© {year} Ignacio Gunst</span>
			<span>{t.contact.footer}</span>
		</div>
	</div>
</section>

<script>
	const button = document.getElementById("copy-mail");
	const toast = document.getElementById("copy-toast");

	if (button && toast) {
		let timer: ReturnType<typeof setTimeout>;

		const flash = (message: string) => {
			toast.textContent = message;
			toast.classList.remove("opacity-0");
			clearTimeout(timer);
			timer = setTimeout(() => toast.classList.add("opacity-0"), 2000);
		};

		const legacyCopy = (text: string) => {
			const field = document.createElement("textarea");
			field.value = text;
			field.setAttribute("readonly", "");
			field.style.position = "fixed";
			field.style.opacity = "0";
			document.body.append(field);
			field.select();
			const ok = document.execCommand("copy");
			field.remove();
			return ok;
		};

		button.addEventListener("click", async () => {
			const email = atob(button.dataset.email!);
			const copied = button.dataset.copied!;
			const failed = button.dataset.failed!;

			try {
				await navigator.clipboard.writeText(email);
				flash(copied);
			} catch {
				flash(legacyCopy(email) ? copied : `${failed} — ${email}`);
			}
		});
	}
</script>
