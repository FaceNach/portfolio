---
import { SECTION } from "../data/sections";
import { dict } from "../i18n";

const t = dict(Astro.currentLocale);

const year = new Date().getFullYear();

const social = [
	{ href: t.contact.github, label: t.contact.githubLabel },
	{
		href: t.contact.linkedin,
		label: t.contact.linkedinLabel,
	},
];

const emailEncoded = btoa(t.contact.email);

const linkClass =
	"group -my-2 flex cursor-pointer items-center py-2 text-amber transition-colors hover:text-amber-hi";
const bracketClass = "opacity-50";
const labelClass = "underline-offset-4 group-hover:underline";
---

<section
	id={SECTION.contact}
	class="scroll-mt-14 border-t border-amber/25 bg-panel px-5 py-14 sm:px-8 md:px-14 md:py-20"
>
	<div class="mx-auto max-w-[72rem]">
		<p class="font-mono text-xs tracking-[0.14em] text-amber">
			{t.contact.label}
		</p>

		<h2
			class="mt-3 font-mono text-2xl font-medium tracking-[-0.02em] text-bone sm:text-3xl"
		>
			<span class="mr-1 text-amber">$</span>{t.contact.command}<span
				class="caret"
				aria-hidden="true"></span
			>
		</h2>

		<dl
			class="mt-9 max-w-[46ch] font-mono text-sm leading-7 sm:text-[15px]"
		>
			{
				t.contact.status.map((s) => (
					<div class="flex gap-4">
						<dt class="w-[9ch] shrink-0 text-faint">{s.key}</dt>
						<dd class={s.key === "status" ? "text-amber-hi" : "text-bone"}>
							{s.value}
						</dd>
					</div>
				))
			}
		</dl>

		<div class="mt-9 font-mono text-sm sm:text-[15px]">
			<p class="text-muted">
				<span class="text-amber">&gt;</span> {t.contact.lookingLabel}
			</p>
			<ul class="mt-1 space-y-0.5 pl-4 text-bone">
				{
					t.contact.lookingFor.map((item) => (
						<li>{item}</li>
					))
				}
			</ul>
		</div>

		<div
			class="relative mt-11 flex flex-wrap items-center gap-x-7 gap-y-3 font-mono text-base"
		>
			<button
				type="button"
				id="copy-mail"
				data-email={emailEncoded}
				data-copied={t.contact.emailCopied}
				data-failed={t.contact.emailFailed}
				aria-label={t.contact.emailAction}
				class={linkClass}
			>
				<span class={bracketClass}>[</span>
				<span class={labelClass}>{t.contact.emailLabel}</span>
				<span class={bracketClass}>]</span>
			</button>

			{
				social.map((item) => (
					<a
						href={item.href}
						target="_blank"
						rel="noopener noreferrer"
						class={linkClass}
					>
						<span class={bracketClass}>[</span>
						<span class={labelClass}>{item.label}</span>
						<span class={bracketClass}>]</span>
					</a>
				))
			}

			<span
				id="copy-toast"
				role="status"
				aria-live="polite"
				class="pointer-events-none absolute bottom-full left-0 mb-2 border border-amber/40 bg-cell px-2.5 py-1 text-[11px] text-amber-hi opacity-0 transition-opacity duration-200"
			></span>
		</div>

		<div
			class="mt-12 flex flex-wrap items-center justify-between gap-2 border-t border-amber/25 pt-5 font-mono text-[11px] text-faint"
		>
			<span>© {year} Ignacio Gunst</span>
			<span>{t.contact.footer}</span>
		</div>
	</div>
</section>

<script>
	const button = document.getElementById("copy-mail");
	const toast = document.getElementById("copy-toast");

	if (button && toast) {
		let timer: ReturnType<typeof setTimeout>;

		const flash = (message: string, ms = 3500) => {
			toast.textContent = message;
			toast.classList.remove("opacity-0");
			clearTimeout(timer);
			timer = setTimeout(() => toast.classList.add("opacity-0"), ms);
		};

		const legacyCopy = (text: string) => {
			const field = document.createElement("textarea");
			field.value = text;
			field.setAttribute("readonly", "");
			field.style.position = "fixed";
			field.style.opacity = "0";
			document.body.append(field);
			field.select();
			const ok = document.execCommand("copy");
			field.remove();
			return ok;
		};

		button.addEventListener("click", async () => {
			const email = atob(button.dataset.email!);
			const copied = button.dataset.copied!;
			const failed = button.dataset.failed!;

			try {
				await navigator.clipboard.writeText(email);
				flash(copied);
			} catch {
				if (legacyCopy(email)) flash(copied);
				else flash(`${failed} — ${email}`, 15000);
			}
		});
	}
</script>
