---
import { iconsFor, techMarkId } from "../data/tech";
import {
	ICON_DB,
	ICON_DB_ID,
	ICON_GITHUB,
	ICON_LANG,
	ICON_LANG_ID,
	ICON_LIB,
	ICON_LIB_ID,
	ICON_LINKEDIN,
	ICON_MAIL,
	iconId,
	trimPath,
} from "../data/icons";
import { dict } from "../i18n";

const t = dict(Astro.currentLocale);

const projectTech = t.projectList.flatMap((project) => project.tech);

const tech = iconsFor([
	...t.stack.groups.flatMap((group) => group.items),
	...projectTech,
]);

const marks = new Set(projectTech.map(techMarkId));

const generic = [
	{ id: ICON_LIB_ID, path: ICON_LIB, evenodd: true },
	{ id: ICON_LANG_ID, path: ICON_LANG, evenodd: false },
	{ id: ICON_DB_ID, path: ICON_DB, evenodd: false },
].filter((item) => marks.has(item.id));
---

<svg
	xmlns="http://www.w3.org/2000/svg"
	aria-hidden="true"
	style="position:absolute;width:0;height:0;overflow:hidden"
>
	{
		tech.map((item) => (
			<symbol id={iconId(item.name)} viewBox="0 0 24 24">
				<path d={trimPath(item.icon.path)} />
			</symbol>
		))
	}

	{
		generic.map((item) => (
			<symbol id={item.id} viewBox="0 0 24 24">
				<path fill-rule={item.evenodd ? "evenodd" : undefined} d={trimPath(item.path)} />
			</symbol>
		))
	}

	<symbol id="icon-mail" viewBox="0 0 24 24">
		<path fill-rule="evenodd" d={trimPath(ICON_MAIL)}></path>
	</symbol>
	<symbol id="icon-github" viewBox="0 0 24 24">
		<path d={trimPath(ICON_GITHUB)}></path>
	</symbol>
	<symbol id="icon-linkedin" viewBox="0 0 24 24">
		<path d={trimPath(ICON_LINKEDIN)}></path>
	</symbol>
</svg>
