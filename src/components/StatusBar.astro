<div
	class="fixed inset-x-0 bottom-0 z-50 flex h-8 items-center gap-3 border-t border-amber/25 bg-panel/95 px-3 font-mono text-[11px] backdrop-blur-sm sm:px-4"
	aria-hidden="true"
>
	<span id="status-section" class="min-w-0 flex-1 truncate text-amber"></span>
	<span id="scroll-pct" class="w-9 shrink-0 text-right tabular-nums text-faint"
		>0%</span
	>
</div>

<script>
	const pct = document.getElementById("scroll-pct")!;

	const updatePct = () => {
		const scrollable = document.body.scrollHeight - window.innerHeight;
		const ratio = scrollable > 0 ? window.scrollY / scrollable : 0;
		pct.textContent = `${Math.round(Math.min(1, Math.max(0, ratio)) * 100)}%`;
	};
	updatePct();
	window.addEventListener("scroll", updatePct, { passive: true });
	window.addEventListener("resize", updatePct);
</script>
