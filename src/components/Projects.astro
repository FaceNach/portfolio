---
import Icon from "./Icon.astro";
import { techMarkId } from "../data/tech";
import { SECTION } from "../data/sections";
import { dict } from "../i18n";

const t = dict(Astro.currentLocale);
---

<section
	id={SECTION.projects}
	class="scroll-mt-14 border-t border-amber/15 px-5 py-14 sm:px-8 md:px-14 md:py-20"
>
	<div class="mx-auto max-w-[72rem]">
		<p class="font-mono text-xs tracking-[0.14em] text-amber">
			{t.projects.label}
		</p>
		<h2
			class="mt-3 font-mono text-2xl font-medium tracking-[-0.02em] text-bone sm:text-3xl"
		>
			{t.projects.heading}
		</h2>

		<ul class="mt-10 border-t border-amber/15">
			{
				t.projectList.map((project) => (
					<li class="border-b border-amber/15">
						<details
							id={project.slug}
							class="group scroll-mt-14 open:bg-amber/[0.03]"
						>
							<summary class="flex cursor-pointer list-none flex-wrap items-center gap-x-4 gap-y-2 px-2 py-4 transition-colors hover:bg-amber/5 [&::-webkit-details-marker]:hidden">
								<span
									class="font-mono text-xs text-amber transition-transform group-open:rotate-90"
									aria-hidden="true"
								>
									▸
								</span>
								<h3 class="font-mono text-lg text-amber-hi sm:text-xl">
									{project.name}
								</h3>

								{project.repo && (
									<span class="font-mono text-[11px] text-faint">
										{project.repo.split("/").pop()}
									</span>
								)}

								<span class="flex w-full flex-wrap items-center gap-x-4 gap-y-1.5 sm:ml-auto sm:w-auto sm:pl-4">
									{project.tech.map((name) => (
										<span class="flex items-center gap-1.5">
											<Icon
												id={techMarkId(name)}
												class="size-3.5 shrink-0 fill-amber/70"
											/>
											<span class="font-mono text-[11px] text-muted">
												{name}
											</span>
										</span>
									))}
								</span>
							</summary>

							<div class="grid gap-x-10 gap-y-5 px-2 pt-1 pb-7 sm:grid-cols-2 sm:pl-8">
								<div>
									<p class="font-mono text-[11px] tracking-[0.1em] text-faint">
										{t.projects.detailLabel}
									</p>
									<p class="mt-2 max-w-[52ch] text-[15px] leading-[1.7] text-bone">
										{project.detail}
									</p>
								</div>

								<div>
									<p class="font-mono text-[11px] tracking-[0.1em] text-faint">
										{t.projects.noteLabel}
									</p>
									<p class="mt-2 max-w-[52ch] text-[15px] leading-[1.7] text-muted">
										{project.note}
									</p>
								</div>

								<div class="flex flex-wrap gap-x-6 gap-y-2 font-mono text-xs sm:col-span-2">
									{project.url && (
										<a
											href={project.url}
											target="_blank"
											rel="noopener noreferrer"
											class="text-amber underline-offset-4 hover:text-amber-hi hover:underline"
										>
											{t.projects.visit} →
										</a>
									)}
									{project.repo && (
										<a
											href={project.repo}
											target="_blank"
											rel="noopener noreferrer"
											class="text-amber underline-offset-4 hover:text-amber-hi hover:underline"
										>
											{t.projects.source} →
										</a>
									)}
									{!project.url && !project.repo && (
										<span class="text-faint">{t.projects.noLinks}</span>
									)}
								</div>
							</div>
						</details>
					</li>
				))
			}
		</ul>
	</div>
</section>

<script>
	const openFromHash = () => {
		const id = decodeURIComponent(location.hash.slice(1));
		if (!id) return;
		const target = document.getElementById(id);
		if (target instanceof HTMLDetailsElement) {
			target.open = true;
			target.scrollIntoView();
		}
	};

	openFromHash();
	window.addEventListener("hashchange", openFromHash);
</script>
