---
import BrowserWindow from "./BrowserWindow.astro";
import { projects, displayUrl } from "../data/portfolio";

const first = projects[0];
---

<section
	id="proyectos"
	class="scroll-mt-[65px] border-t border-faint/20 px-6 py-[88px] md:px-12 md:py-[140px]"
>
	<div class="mx-auto max-w-[1200px]">
		<h3
			class="mb-3 font-display text-[34px] font-semibold italic text-bone"
		>
			Algunas cosas que hice
		</h3>
		<p class="mb-12 text-sm text-faint">
			Elegí un proyecto de la lista para ver su vista previa embebida.
		</p>

		<div class="grid items-start gap-12 lg:grid-cols-2">
			<div
				class="flex max-h-[620px] flex-col gap-3.5 overflow-y-auto pr-2"
				role="list"
			>
				{
					projects.map((project, i) => (
						<button
							type="button"
							role="listitem"
							data-project-card
							data-url={project.url ?? ""}
							data-display-url={displayUrl(project.url)}
							data-title={project.title}
							aria-current={i === 0 ? "true" : "false"}
							class="group cursor-pointer rounded-[10px] border border-faint/30 bg-transparent px-[22px] py-5 text-left transition-colors hover:border-faint/60 aria-[current=true]:border-gold aria-[current=true]:bg-gold/10"
						>
							<div class="mb-2 flex items-center justify-between gap-3">
								<h4 class="font-display text-[17px] text-bone group-aria-[current=true]:text-gold-light">
									{project.title}
								</h4>
								<span class="shrink-0 font-mono text-[11px] text-faint">
									{String(i + 1).padStart(2, "0")}
								</span>
							</div>
							<p class="mb-3 text-sm leading-[1.55] text-muted">
								{project.desc}
							</p>
							<div class="flex flex-wrap gap-2">
								{project.tags.map((tag) => (
									<span class="rounded-full bg-faint/[0.18] px-2.5 py-1 font-mono text-[11px] text-muted">
										{tag}
									</span>
								))}
							</div>
						</button>
					))
				}
			</div>

			<div class="top-[100px] flex flex-col items-center gap-3.5 lg:sticky">
				<BrowserWindow
					tab={first.title}
					url={displayUrl(first.url)}
					tabId="project-tab"
					urlId="project-url"
				>
					<iframe
						id="project-frame"
						src={first.url ?? undefined}
						title="Vista previa del proyecto"
						class="size-full border-none bg-white"
						hidden={!first.url}></iframe>
					<div
						id="project-placeholder"
						class="flex size-full items-center justify-center bg-[repeating-linear-gradient(45deg,#e9e9ea,#e9e9ea_12px,#f4f4f5_12px,#f4f4f5_24px)]"
						hidden={!!first.url}
					>
						<span class="font-mono text-xs text-[#8a8a8f]"
							>captura del proyecto</span
						>
					</div>
				</BrowserWindow>
				<p
					class="max-w-[640px] text-center font-mono text-[11px] text-faint"
				>
					Vista previa en vivo — reemplazá la URL de cada proyecto por su link
					real cuando lo publiques.
				</p>
			</div>
		</div>
	</div>
</section>

<script>
	const cards = document.querySelectorAll<HTMLButtonElement>(
		"[data-project-card]",
	);
	const frame = document.getElementById("project-frame") as HTMLIFrameElement;
	const placeholder = document.getElementById("project-placeholder")!;
	const tabLabel = document.getElementById("project-tab")!;
	const urlLabel = document.getElementById("project-url")!;

	const select = (card: HTMLButtonElement) => {
		for (const other of cards) {
			other.setAttribute("aria-current", String(other === card));
		}

		const url = card.dataset.url;
		tabLabel.textContent = card.dataset.title ?? "";
		urlLabel.textContent = card.dataset.displayUrl ?? "";

		if (url) {
			frame.src = url;
			frame.hidden = false;
			placeholder.hidden = true;
		} else {
			frame.removeAttribute("src");
			frame.hidden = true;
			placeholder.hidden = false;
		}
	};

	for (const card of cards) {
		card.addEventListener("click", () => select(card));
	}
</script>
