---
import { profile } from "../data/portfolio";

const links = [
	{ href: "#about", label: "Sobre mí" },
	{ href: "#skills", label: "Skills" },
	{ href: "#proyectos", label: "Proyectos" },
	{ href: "#contacto", label: "Contacto" },
];
---

<nav
	class="fixed inset-x-0 top-0 z-50 flex items-center justify-between gap-4 border-b border-faint/25 bg-ink/80 px-6 py-5 backdrop-blur-[10px] md:px-12"
>
	<a
		href="#top"
		class="font-mono text-base tracking-[0.5px] text-gold no-underline">{profile.initials}</a
	>
	<div class="flex gap-4 sm:gap-9">
		{
			links.map((link) => (
				<a
					href={link.href}
					class="text-[13px] text-muted no-underline transition-colors hover:text-bone sm:text-sm"
				>
					{link.label}
				</a>
			))
		}
	</div>
</nav>
