---
import { profile } from "../data/portfolio";
---

<section
	id="top"
	class="relative flex min-h-screen flex-col justify-center px-6 md:px-12"
>
	<div class="max-w-[900px]">
		<p class="mb-5 font-mono text-[15px] tracking-[1px] text-gold">Hola, soy</p>
		<h1
			class="mb-5 font-display text-[clamp(48px,8vw,96px)] leading-[1.02] font-bold text-bone"
		>
			{profile.name}
		</h1>
		<h2
			class="mb-6 font-display text-[clamp(20px,2.6vw,32px)] font-medium text-muted"
		>
			{profile.role}
		</h2>
		<p class="max-w-[560px] text-base leading-[1.7] text-muted">
			{profile.tagline}
		</p>
	</div>

	<div
		class="absolute bottom-12 left-6 flex animate-scrollcue flex-col items-center gap-2 md:left-12"
		aria-hidden="true"
	>
		<span class="font-mono text-[11px] [writing-mode:vertical-rl] text-faint"
			>SCROLL</span
		>
		<div class="h-10 w-px bg-faint"></div>
	</div>
</section>
