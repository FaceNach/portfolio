---
import AmbientLog from "./AmbientLog.astro";
import { SECTION } from "../data/sections";
import { dict } from "../i18n";

const t = dict(Astro.currentLocale);
---

<section
	id={SECTION.top}
	class="relative flex min-h-svh flex-col justify-center overflow-hidden px-5 pt-16 pb-16 sm:px-8 md:px-14"
>
	<AmbientLog />

	<div class="relative mx-auto w-full max-w-[78ch]">
		<div
			class="rise flex flex-wrap items-center gap-x-4 gap-y-1 font-mono text-[11px] text-faint sm:text-xs"
			style="--d:0ms"
		>
			<span class="text-amber">{t.hero.host}</span>
			<span>{t.hero.lastSession}</span>
		</div>

		<div class="rise mt-3 h-px bg-amber/25" style="--d:80ms"></div>

		<h1
			class="rise mt-6 font-mono text-[clamp(2.75rem,11vw,7rem)] leading-[0.92] font-semibold tracking-[-0.03em] text-amber phosphor"
			style="--d:160ms"
		>
			{t.hero.nameFirst}<br />{t.hero.nameLast}<span
				class="caret"
				aria-hidden="true"></span
			>
		</h1>

		<p
			class="rise mt-5 font-mono text-sm text-muted sm:text-base"
			style="--d:240ms"
		>
			{t.hero.role}
		</p>

		<div class="rise mt-5 h-px bg-amber/15" style="--d:300ms"></div>

		<p
			class="rise mt-5 max-w-[58ch] text-[15px] leading-[1.75] text-bone sm:text-base"
			style="--d:360ms"
		>
			{t.hero.intro}
		</p>
	</div>
</section>
