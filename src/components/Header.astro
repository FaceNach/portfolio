---
import { LOCALES, dict, localeHome, toLocale } from "../i18n";
import { SECTION, sectionsFor } from "../data/sections";

const locale = toLocale(Astro.currentLocale);
const t = dict(locale);
const sections = sectionsFor(t);

const languages = LOCALES.map((code) => ({
	code,
	label: dict(code).localeLabel,
	href: localeHome(code),
	current: code === locale,
}));
---

<header
	class="fixed inset-x-0 top-0 z-50 flex h-10 items-center gap-3 border-b border-amber/25 bg-panel/95 px-3 font-mono text-[11px] backdrop-blur-sm sm:gap-5 sm:px-4"
>
	<a
		href={`#${SECTION.top}`}
		class="relative grid size-6 shrink-0 place-items-center rounded-[5px] border border-amber/40 bg-ink font-semibold tracking-[-0.02em] text-amber no-underline transition-colors before:absolute before:-inset-2 before:content-[''] hover:border-amber-hi hover:text-amber-hi"
		>IG</a
	>

	<nav
		class="flex flex-1 items-center gap-3 self-stretch overflow-x-auto sm:gap-5"
		aria-label={t.nav.sectionsLabel}
	>
		{
			sections.map((s) => (
				<a
					href={`#${s.id}`}
					data-nav-link={s.id}
					class="flex shrink-0 items-center self-stretch text-faint no-underline transition-colors hover:text-bone aria-[current=true]:text-amber-hi"
				>
					{s.label}
				</a>
			))
		}
	</nav>

	<nav
		class="flex shrink-0 items-center gap-1.5 self-stretch"
		aria-label={t.nav.languageLabel}
	>
		{
			languages.map((lang, i) => (
				<>
					{i > 0 && (
						<span class="text-amber/30" aria-hidden="true">
							/
						</span>
					)}
					{lang.current ? (
						<span
							class="flex items-center self-stretch text-amber-hi"
							aria-current="true"
						>
							{lang.label}
						</span>
					) : (
						<a
							href={lang.href}
							hreflang={lang.code}
							aria-label={t.nav.switchLanguage}
							class="flex items-center self-stretch px-1 text-faint no-underline transition-colors hover:text-bone"
						>
							{lang.label}
						</a>
					)}
				</>
			))
		}
	</nav>
</header>

<script>
	const links = document.querySelectorAll<HTMLAnchorElement>("[data-nav-link]");
	const sections = [...links]
		.map((l) => document.getElementById(l.dataset.navLink!))
		.filter((el): el is HTMLElement => el !== null);

	const statusLabel = document.getElementById("status-section");

	const setCurrent = (id: string | null) => {
		for (const link of links) {
			link.setAttribute("aria-current", String(link.dataset.navLink === id));
		}
		if (statusLabel) {
			const label = [...links]
				.find((l) => l.dataset.navLink === id)
				?.textContent?.trim();
			statusLabel.textContent = label ? `§ ${label}` : "";
		}
	};

	const restPoint = () =>
		sections[0]
			? parseFloat(getComputedStyle(sections[0]).scrollMarginTop) || 56
			: 56;

	let trigger = restPoint() + 2;

	const activeId = () => {
		const doc = document.documentElement;
		if (window.scrollY + window.innerHeight >= doc.scrollHeight - 4) {
			return sections[sections.length - 1]?.id ?? null;
		}

		let current: string | null = null;
		for (const section of sections) {
			if (section.getBoundingClientRect().top <= trigger) current = section.id;
		}
		return current;
	};

	let queued = false;
	const update = () => {
		if (queued) return;
		queued = true;
		requestAnimationFrame(() => {
			queued = false;
			setCurrent(activeId());
		});
	};

	update();
	window.addEventListener("scroll", update, { passive: true });
	window.addEventListener("resize", () => {
		trigger = restPoint() + 2;
		update();
	});
</script>
