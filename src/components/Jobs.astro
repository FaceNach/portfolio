---
import t from "../i18n/dataEs";

const statusColor = {
	prod: "text-amber-hi",
	curso: "text-amber",
	archivado: "text-faint",
} as const;

const cols = "md:grid-cols-[8ch_minmax(0,1fr)_24ch_11ch_9ch]";
---

<section
	id="obra"
	class="scroll-mt-4 border-t border-amber/15 px-5 py-14 sm:px-8 md:px-14 md:py-20"
>
	<div class="mx-auto max-w-[72rem]">
		<p class="font-mono text-xs tracking-[0.14em] text-amber">{t.jobs.label}</p>
		<h2
			class="mt-3 font-mono text-2xl font-medium tracking-[-0.02em] text-bone sm:text-3xl"
		>
			{t.jobs.heading}
		</h2>
		<p class="mt-3 text-sm text-muted">{t.jobs.note}</p>

		{/* Cabecera de columnas — solo tiene sentido cuando entran las cinco */}
		<div
			class={`mt-8 hidden border-b border-amber/30 px-2 pb-2 font-mono text-[11px] tracking-[0.1em] text-faint md:grid md:gap-x-4 ${cols}`}
			aria-hidden="true"
		>
			<span>{t.jobs.columns.id}</span>
			<span>{t.jobs.columns.name}</span>
			<span>{t.jobs.columns.stack}</span>
			<span>{t.jobs.columns.status}</span>
			<span class="text-right">{t.jobs.columns.elapsed}</span>
		</div>

		<div class="max-md:mt-8 max-md:border-t max-md:border-amber/30">
			{
				t.jobsList.map((job) => (
					<details class="group border-b border-amber/15">
						<summary
							class={`grid cursor-pointer list-none grid-cols-[8ch_minmax(0,1fr)] items-baseline gap-x-4 gap-y-1 px-2 py-4 transition-colors hover:bg-amber/6 [&::-webkit-details-marker]:hidden ${cols}`}
						>
							<span class="font-mono text-xs text-faint">
								<span
									class="mr-1 inline-block text-amber transition-transform group-open:rotate-90"
									aria-hidden="true"
								>
									▸
								</span>
								{job.id}
							</span>

							<span class="font-mono text-base text-bone group-open:text-amber-hi">
								{job.name}
							</span>

							<span class="col-start-2 font-mono text-xs text-muted md:col-start-3">
								{job.stack.join(" · ")}
							</span>

							<span
								class={`col-start-2 font-mono text-[11px] tracking-[0.08em] md:col-start-4 ${statusColor[job.status]}`}
							>
								{t.jobs.status[job.status]}
							</span>

							<span class="col-start-2 font-mono text-[11px] text-faint md:col-start-5 md:text-right">
								{job.elapsed}
							</span>
						</summary>

						<div class="grid gap-6 px-2 pt-1 pb-8 md:grid-cols-[8ch_minmax(0,1fr)] md:gap-x-4">
							<div class="max-w-[62ch] md:col-start-2">
								<p class="font-mono text-[11px] tracking-[0.1em] text-faint">
									{t.jobs.detailLabel}
								</p>
								<p class="mt-2 text-[15px] leading-[1.75] text-bone">
									{job.detail}
								</p>

								<p class="mt-6 font-mono text-[11px] tracking-[0.1em] text-faint">
									{t.jobs.noteLabel}
								</p>
								<p class="mt-2 text-[15px] leading-[1.75] text-muted">
									{job.note}
								</p>

								<div class="mt-6 flex flex-wrap gap-x-6 gap-y-2 font-mono text-xs">
									{job.url && (
										<a
											href={job.url}
											class="text-amber underline-offset-4 hover:text-amber-hi hover:underline"
										>
											{t.jobs.visit} →
										</a>
									)}
									{job.repo && (
										<a
											href={job.repo}
											class="text-amber underline-offset-4 hover:text-amber-hi hover:underline"
										>
											{t.jobs.source} →
										</a>
									)}
									{!job.url && !job.repo && (
										<span class="text-faint">{t.jobs.noLinks}</span>
									)}
								</div>
							</div>
						</div>
					</details>
				))
			}
		</div>
	</div>
</section>
