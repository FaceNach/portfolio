---
import SkillCard from "./SkillCard.astro";
import { skillGroups } from "../data/portfolio";
---

<section
	id="skills"
	class="scroll-mt-[65px] border-t border-faint/20 bg-ink-alt px-6 py-[88px] md:px-12 md:py-[140px]"
>
	<div
		class="mx-auto grid max-w-[1100px] items-start gap-10 md:grid-cols-[280px_1fr] md:gap-16"
	>
		<h3
			class="font-display text-[36px] leading-[1.04] font-bold italic md:text-[48px]"
		>
			<span class="text-gold">Stack</span><br />
			<span class="text-muted">técnico</span>
		</h3>
		<div class="grid gap-5 sm:grid-cols-2">
			{
				skillGroups.map((group) => (
					<SkillCard title={group.title} items={group.items} />
				))
			}
		</div>
	</div>
</section>
